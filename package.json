{
  "name": "sportsbuilder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "web": "bun run --cwd Web dev",
    "agent": "bun --watch agent/server.ts",
    "build": "bun run typecheck && bun run --cwd Web build",
    "typecheck": "tsc --noEmit",
    "ai:proxy": "npx openai-oauth@2.0.0 --no-open",
    "check": "bun run typecheck && python3 -m compileall -q server"
  },
  "dependencies": {
    "@daytonaio/sdk": "^0.224.0",
    "express": "^5.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  },
  "workspaces": [
    "Web"
  ]
}
